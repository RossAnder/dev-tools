# eggshell (dark) for Ghostty and Ghostty-based terminals such as Rootshell
# on iOS. Colours from themes/palette.toml, the same values as
# themes/alacritty/eggshell.toml. Pair it with the light variant:
#   theme = light:eggshell-light,dark:eggshell

palette = 0=#232323
palette = 1=#e5715a
palette = 2=#72bf89
palette = 3=#f9cb92
palette = 4=#5884f8
palette = 5=#c8c8c8
palette = 6=#c4d5ff
palette = 7=#c8c8c8
palette = 8=#5e5e5e
palette = 9=#fb846c
palette = 10=#77d695
palette = 11=#fdd39c
palette = 12=#c4d5ff
palette = 13=#f2f2f2
palette = 14=#c4d5ff
palette = 15=#ffffff

background = #0a0a0a
foreground = #c8c8c8
cursor-color = #f2f2f2
cursor-text = #0a0a0a
# Text selection is the deep blue. Ghostty can keep each cell's own colour
# (selection-foreground = cell-foreground); a fixed foreground is used here
# because older libghostty builds do not accept that keyword.
selection-background = #12276e
selection-foreground = #f2f2f2
