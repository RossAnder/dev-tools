#!/usr/bin/env bash
# Warns when the Claude config dir (CLAUDE_CONFIG_DIR, default ~/.claude) has fallen
# out of sync with claude/. Never blocks.
# $3 is 1 for a branch checkout, 0 for a file checkout, which cannot add or drop entries.
[ "${3:-0}" = 1 ] || exit 0
exec "$(git rev-parse --show-toplevel)/.githooks/deploy-check.sh"
