#!/usr/bin/env bash
set -euo pipefail

STAGED=$(git diff --cached --name-only)

if [ -z "$STAGED" ]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
"$ROOT/scripts/verify-shared-blocks.sh"
"$ROOT/scripts/verify-plan-story-blocks.sh"
# Reports, does not block. Promote with DOC_GATE_MODE=block once its
# false-positive rate is proven against real commits rather than specimens.
"$ROOT/scripts/doc-diff-gate.sh"

# Crate-wide by construction: cargo fmt cannot be narrowed to a path, so one
# staged *.rs gates on the whole crate, including files this commit never touched.
if grep -q '\.rs$' <<<"$STAGED"; then
  cargo fmt --manifest-path "$ROOT/tomlctl/Cargo.toml" -- --check
fi

# Runs the command given; on failure blocks the commit and names it for a rerun.
gate() {
  if ! "$@"; then
    printf 'pre-commit: blocked. Rerun after fixing:\n  %s\n' "$*" >&2
    exit 1
  fi
}

# Carrier, flag-table, finding-class and skill gates over claude/ and the CLI.
if grep -Eq '^(claude/.*\.md|tomlctl/src/.*)$' <<<"$STAGED"; then
  gate cargo test --manifest-path "$ROOT/tomlctl/Cargo.toml" --bin tomlctl -- cli::dispatch::tests
fi

# The plan corpus test is #[ignore]d so plan edits cannot fail `cargo test`.
if grep -Eq '^docs/plans/.*\.md$' <<<"$STAGED"; then
  gate cargo test --manifest-path "$ROOT/tomlctl/Cargo.toml" --test tasks_corpus -- --ignored
fi
