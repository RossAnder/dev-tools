#!/usr/bin/env bash
set -euo pipefail

STAGED=$(git diff --cached --name-only)

if [ -z "$STAGED" ]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
"$ROOT/scripts/verify-shared-blocks.sh"
"$ROOT/scripts/verify-plan-story-blocks.sh"
# Reports, does not block. Promote with DOC_GATE_MODE=block once its
# false-positive rate is proven against real commits rather than specimens
# (measure it with `scripts/doc-diff-gate.sh --range A..B`).
"$ROOT/scripts/doc-diff-gate.sh"

# A sidecar must digest the bytes being committed, so both sides come from the
# index, which autocrlf leaves LF. Raw hash, no line-ending folding: a digest stamped
# over CRLF fails here rather than on the next checkout. `:0:` keeps a path such as
# `1:x` from reading as a merge stage; `-b` is sha256sum's binary mode.
SIDECAR_MISMATCH=0
while IFS= read -r -d '' sidecar; do
  store=${sidecar%.sha256}
  case "$store" in '' | */) continue ;; esac
  [ -n "$(git diff --cached --name-only --diff-filter=d -- ":(top,literal)$store")" ] || continue
  sidecar_text=$(git cat-file blob ":0:$sidecar")
  expected=${sidecar_text%%[[:space:]]*}
  actual=$(git cat-file blob ":0:$store" | sha256sum -b)
  actual=${actual%% *}
  if [ "$expected" != "$actual" ]; then
    printf 'pre-commit: blocked. The staged sidecar does not match its staged store: %s\n  sidecar %s, store %s\n  Re-stage both after the last write to the store.\n' \
      "$store" "$expected" "$actual" >&2
    SIDECAR_MISMATCH=1
  fi
done < <(git diff --cached --name-only -z --diff-filter=d -- ':(top,glob)**/*.sha256')
if [ "$SIDECAR_MISMATCH" -ne 0 ]; then
  exit 1
fi

# Runs the cargo step with the id given, reading its command from
# scripts/gate-stamp.sh's step table; on failure blocks the commit and names the
# command for a rerun. A step whose stamp matches this working tree is skipped.
# The commands are repo-relative; git runs the hook at the top of the working tree.
gate() {
  local id=$1 line
  local -a cmd
  if ! line=$(bash "$ROOT/scripts/gate-stamp.sh" command "$id"); then
    printf 'pre-commit: blocked. scripts/gate-stamp.sh has no command for %s\n' "$id" >&2
    exit 1
  fi
  read -ra cmd <<<"$line"
  if bash "$ROOT/scripts/gate-stamp.sh" check "$id"; then
    printf 'pre-commit: %s skipped, its gate stamp matches this working tree\n' "$id"
    return 0
  fi
  if ! "${cmd[@]}"; then
    printf 'pre-commit: blocked. Rerun after fixing:\n  %s\n' "$line" >&2
    exit 1
  fi
}

# Crate-wide by construction: cargo fmt cannot be narrowed to a path, so one
# staged tomlctl *.rs gates on the whole crate, including files this commit
# never touched.
if grep -Eq '^tomlctl/.*\.rs$' <<<"$STAGED"; then
  gate fmt-tomlctl
fi

# Carrier, flag-table, finding-class, skill, Workflow script and review-lens
# catalogue gates over claude/, the repo's lens config and the CLI.
if grep -Eq '^(claude/.*\.(md|toml)|claude/workflows/.*\.m?js|\.claude/review-lenses/.*|tomlctl/src/.*)$' <<<"$STAGED"; then
  gate dispatch-tests
fi

# The plan corpus test is #[ignore]d so plan edits cannot fail `cargo test`.
if grep -Eq '^docs/plans/.*\.md$' <<<"$STAGED"; then
  gate plan-corpus
fi

# glimpse is a separate crate, so the tomlctl fmt check above never covers it.
if grep -Eq '^glimpse/.*\.rs$' <<<"$STAGED"; then
  gate fmt-glimpse
fi

# glimpse compiles all of tomlctl's library, with no feature gate narrowing it, so any
# library source can break glimpse's build; only the binary's main.rs is outside it.
# A tomlctl version bump or dependency change also needs glimpse/Cargo.lock
# refreshed and staged in the same commit:
# `cargo tree --manifest-path glimpse/Cargo.toml >/dev/null` rewrites it.
LINKED=$(grep -Ev '^tomlctl/src/main\.rs$' <<<"$STAGED" || true)
if grep -Eq '^tomlctl/(Cargo\.toml|src/.+\.rs)$' <<<"$LINKED"; then
  gate glimpse-clippy
fi
