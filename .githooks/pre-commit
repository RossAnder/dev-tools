#!/usr/bin/env bash
set -euo pipefail

STAGED=$(git diff --cached --name-only)

if [ -z "$STAGED" ]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
"$ROOT/scripts/verify-shared-blocks.sh"
"$ROOT/scripts/verify-plan-story-blocks.sh"
# Reports, does not block. Promote with DOC_GATE_MODE=block once its
# false-positive rate is proven against real commits rather than specimens
# (measure it with `scripts/doc-diff-gate.sh --range A..B`).
"$ROOT/scripts/doc-diff-gate.sh"

# Runs the command given; on failure blocks the commit and names it for a rerun.
gate() {
  if ! "$@"; then
    printf 'pre-commit: blocked. Rerun after fixing:\n  %s\n' "$*" >&2
    exit 1
  fi
}

# Crate-wide by construction: cargo fmt cannot be narrowed to a path, so one
# staged tomlctl *.rs gates on the whole crate, including files this commit
# never touched.
if grep -Eq '^tomlctl/.*\.rs$' <<<"$STAGED"; then
  gate cargo fmt --manifest-path "$ROOT/tomlctl/Cargo.toml" -- --check
fi

# Carrier, flag-table, finding-class and skill gates over claude/ and the CLI.
if grep -Eq '^(claude/.*\.md|tomlctl/src/.*)$' <<<"$STAGED"; then
  gate cargo test --manifest-path "$ROOT/tomlctl/Cargo.toml" --lib -- cli::dispatch::tests
fi

# The plan corpus test is #[ignore]d so plan edits cannot fail `cargo test`.
if grep -Eq '^docs/plans/.*\.md$' <<<"$STAGED"; then
  gate cargo test --manifest-path "$ROOT/tomlctl/Cargo.toml" --test tasks_corpus -- --ignored
fi

# glimpse is a separate crate, so the tomlctl fmt check above never covers it.
if grep -Eq '^glimpse/.*\.rs$' <<<"$STAGED"; then
  gate cargo fmt --manifest-path "$ROOT/glimpse/Cargo.toml" -- --check
fi

# glimpse compiles tomlctl in as a library, so a facade change can break glimpse's build.
# A tomlctl version bump or dependency change also needs glimpse/Cargo.lock
# refreshed and staged in the same commit:
# `cargo tree --manifest-path glimpse/Cargo.toml >/dev/null` rewrites it.
if grep -Eq '^tomlctl/(Cargo\.toml|src/(lib|io)\.rs|src/tasks/.*|src/flow/list\.rs|src/agents/.*)$' <<<"$STAGED"; then
  gate cargo clippy --manifest-path "$ROOT/glimpse/Cargo.toml" --locked
fi
