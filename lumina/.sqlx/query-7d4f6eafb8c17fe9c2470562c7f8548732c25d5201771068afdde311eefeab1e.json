  "query": "\n        SELECT\n            id            AS \"id!\",\n            work_item_id  AS \"work_item_id!\",\n            seq           AS \"seq!\",\n            summary       AS \"summary!\",\n            body          AS \"body?\",\n            confidence    AS \"confidence?\",\n            state         AS \"state?\",\n            rationale     AS \"rationale?\",\n            lens          AS \"lens?\",\n            origin        AS \"origin?\",\n            superseded_by AS \"superseded_by?\",\n            created_at    AS \"created_at!\"\n        FROM research_notes\n        WHERE work_item_id = ?1\n          AND superseded_by IS NULL\n        ORDER BY seq\n        ",
