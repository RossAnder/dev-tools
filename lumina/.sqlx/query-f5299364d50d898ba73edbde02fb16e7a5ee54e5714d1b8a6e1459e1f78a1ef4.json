  "query": "\n            SELECT\n                id           AS \"id!\",\n                session_id   AS \"session_id!\",\n                sequence     AS \"sequence!\",\n                created_at   AS \"created_at!\",\n                kind         AS \"kind!\",\n                content_json AS \"content_json!\",\n                raw_text     AS \"raw_text?\"\n            FROM pty_messages\n            WHERE session_id = ?1\n              AND (?2 IS NULL OR sequence > ?2)\n            ORDER BY sequence ASC\n            LIMIT ?3\n            ",
