  "query": "\n            SELECT\n                id            AS \"id!\",\n                session_id    AS \"session_id!\",\n                sequence      AS \"sequence!\",\n                input_kind    AS \"input_kind!\",\n                payload       AS \"payload!\",\n                enqueued_at   AS \"enqueued_at!\",\n                dispatched_at AS \"dispatched_at?\",\n                completed_at  AS \"completed_at?\",\n                status        AS \"status!\",\n                error         AS \"error?\"\n            FROM pty_queue\n            WHERE session_id = ?1\n            ORDER BY sequence ASC\n            ",
