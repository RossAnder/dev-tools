  "query": "\n        SELECT\n            cb.id          AS \"id!\",\n            cb.title       AS \"title?\",\n            cb.body        AS \"body?\",\n            cb.created_at  AS \"created_at!\",\n            cb.updated_at  AS \"updated_at!\"\n        FROM context_blocks cb\n        JOIN work_item_context wic ON wic.context_block_id = cb.id\n        WHERE wic.work_item_id = ?1\n        ORDER BY cb.created_at, cb.id\n        ",
