# Build output
/target/

# Local SQLite databases (the schema lives in migrations/; the .db is disposable)
*.db
*.db-shm
*.db-wal

# Vue toolchain artifacts
web/node_modules/
# web/dist/ is build output. Regenerated by `build.rs` on every `cargo build`
# (which shells out to `bun run build`); set LUMINA_SKIP_WEB_BUILD=1 to skip
# the bun step on hosts without bun — the build script then drops a stub
# index.html so the rust-embed macro still compiles.
web/dist/

# NOTE: the following are intentionally TRACKED (do not add them here):
#   .sqlx/            — committed offline query cache (cargo sqlx prepare)
#   .env              — holds only a local sqlite path, safe to commit
#   .lumina/export/   — git-export snapshots are the audit trail; must be tracked

# <!-- TEST-BOOTSTRAP:GITIGNORE START -->
# Coverage artefacts (cargo-llvm-cov)
target/coverage/
lcov.info
cobertura.xml
# proptest persisted-regression cases (committed convention varies; default to ignore)
proptest-regressions/
# <!-- TEST-BOOTSTRAP:GITIGNORE END -->
