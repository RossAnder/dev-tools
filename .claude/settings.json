{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(tomlctl *)"
    ],
    "deny": [
      "Bash(tomlctl --allow-outside *)",
      "Bash(tomlctl * --allow-outside)",
      "Bash(tomlctl * --allow-outside *)"
    ]
  },
  "plansDirectory": "docs/plans/",
  "enabledPlugins": {
    "lumina@dev-tools-local": true
  }
}
