{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "enabledPlugins": {
    "lumina@dev-tools-local": true
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "timeout": 30,
            "type": "http",
            "url": "http://127.0.0.1:24817/api/sessions/ingest"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(tomlctl *)"
    ],
    "deny": [
      "Bash(tomlctl --allow-outside *)",
      "Bash(tomlctl * --allow-outside)",
      "Bash(tomlctl * --allow-outside *)"
    ]
  },
  "plansDirectory": "docs/plans/"
}
